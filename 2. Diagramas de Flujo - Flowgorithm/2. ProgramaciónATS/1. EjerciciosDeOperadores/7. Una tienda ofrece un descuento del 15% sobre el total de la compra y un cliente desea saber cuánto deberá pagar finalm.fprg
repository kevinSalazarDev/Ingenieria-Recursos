    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="precio, precioTotalDescuento" type="Real" array="False" size=""/>
            <output expression="&quot;Ingrese el precio del producto:&quot;" newline="True"/>
            <input variable="precio"/>
            <assign variable="precioTotalDescuento" expression="Precio - (precio*15)/100"/>
            <output expression="&quot;El precio total con descuento del 15% es : &quot; &amp; precioTotalDescuento" newline="True"/>
        </body>
    </function>
</flowgorithm>
