<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Ejercicio_11"/>
        <attribute name="authors" value="K"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-07-27 09:20:09 p.&#160;m."/>
        <attribute name="created" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wNy0yNzswOTowNjo0MiBwLsKgbS47MjczMA=="/>
        <attribute name="edited" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wNy0yNzswOToyMDowOSBwLsKgbS47MTsyODM3"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="horas" type="Real" array="False" size=""/>
            <declare name="minutos" type="Real" array="False" size=""/>
            <declare name="segundos" type="Real" array="False" size=""/>
            <declare name="horasAsegundos" type="Real" array="False" size=""/>
            <declare name="minutosAsegundos" type="Real" array="False" size=""/>
            <declare name="segundosAsegundos" type="Real" array="False" size=""/>
            <declare name="tiempoTotalEnSegundos" type="Real" array="False" size=""/>
            <output expression="&quot;Ingrese las horas:&quot;" newline="True"/>
            <input variable="horas"/>
            <output expression="&quot;Ingrese los minutos:&quot;" newline="True"/>
            <input variable="minutos"/>
            <output expression="&quot;Ingrese los segundos:&quot;" newline="True"/>
            <input variable="segundos"/>
            <assign variable="horasAsegundos" expression="horas*3600"/>
            <assign variable="minutosAsegundos" expression="minutos*60"/>
            <assign variable="segundosAsegundos" expression="segundos*1"/>
            <assign variable="tiempoTotalEnSegundos" expression="horasAsegundos+minutosAsegundos+segundosAsegundos"/>
            <output expression="&quot;El tiempo total en segundos es: &quot; &amp; tiempoTotalEnSegundos" newline="True"/>
        </body>
    </function>
</flowgorithm>
