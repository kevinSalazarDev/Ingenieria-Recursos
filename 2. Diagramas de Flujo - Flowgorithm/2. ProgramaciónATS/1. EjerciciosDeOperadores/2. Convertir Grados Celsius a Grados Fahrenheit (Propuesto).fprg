    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="celsius, fahrenheit" type="Real" array="False" size=""/>
            <output expression="&quot;Ingrese los grados celsius:&quot;" newline="True"/>
            <input variable="celsius"/>
            <assign variable="fahrenheit" expression="(9/5)*(Celsius)+32"/>
            <output expression="fahrenheit &amp; &quot; grados farenheit&quot;" newline="True"/>
        </body>
    </function>
