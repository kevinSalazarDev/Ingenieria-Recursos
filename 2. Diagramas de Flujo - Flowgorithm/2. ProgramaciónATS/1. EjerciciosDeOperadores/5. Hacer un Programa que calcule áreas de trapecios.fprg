<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Ejercicio_5"/>
        <attribute name="authors" value="K"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-07-23 08:03:54 p.&#160;m."/>
        <attribute name="created" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wNy0yMzswNzo1NToyOSBwLsKgbS47MjczMw=="/>
        <attribute name="edited" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wNy0yMzswODowMzo1NCBwLsKgbS47MTsyODMz"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="bMayor, bMenor, altura, area" type="Real" array="False" size=""/>
            <output expression="&quot;Ingrese la base mayor:&quot;" newline="True"/>
            <input variable="bMayor"/>
            <output expression="&quot;Ingrese la base menor:&quot;" newline="True"/>
            <input variable="bMenor"/>
            <output expression="&quot;Ingrese la altura:&quot;" newline="True"/>
            <input variable="altura"/>
            <assign variable="area" expression="(bMayor+BMEnor)*altura/2"/>
            <output expression="&quot;El area del trapecio es: &quot; &amp; area &amp; &quot; cm^2&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
