    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="radio, perimetro" type="Real" array="False" size=""/>
            <output expression="&quot;Ingrese el radio del circulo:&quot;" newline="True"/>
            <input variable="radio"/>
            <assign variable="perimetro" expression="2 * pi * radio"/>
            <output expression="&quot;El perimetro de la circunferencia es: &quot; &amp; perimetro" newline="True"/>
        </body>
    </function>
</flowgorithm>
