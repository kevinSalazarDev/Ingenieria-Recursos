    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="salarioActual, SalarioActualAumento" type="Real" array="False" size=""/>
            <output expression="&quot;Ingrese su salario actual:&quot;" newline="True"/>
            <input variable="salarioActual"/>
            <assign variable="salarioActualAumento" expression="salarioActual * 25 /100 + salarioActual"/>
            <output expression="&quot;Su salario actual mas un aumento del 25% es: &quot; &amp; salarioActualAumento" newline="True"/>
        </body>
    </function>
</flowgorithm>
