<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Ejercicio_15"/>
        <attribute name="authors" value="K"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-07-28 08:11:51 p.&#160;m."/>
        <attribute name="created" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wNy0yODswNzo1ODo1OSBwLsKgbS47Mjc0NA=="/>
        <attribute name="edited" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wNy0yODswODoxMTo1MSBwLsKgbS47MjsyODM1"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="i1, i2, i3, it, p1, p2, p3" type="Real" array="False" size=""/>
            <output expression="&quot;Ingrese el valor del primer inversionista:&quot;" newline="True"/>
            <input variable="i1"/>
            <output expression="&quot;Ingrese el valor del segundo inversionista:&quot;" newline="True"/>
            <input variable="i2"/>
            <output expression="&quot;Ingrese el valor del tercer inversionista:&quot;" newline="True"/>
            <input variable="i3"/>
            <assign variable="it" expression="i1+i2+i3"/>
            <assign variable="p1" expression="(i1*100)/it"/>
            <assign variable="p2" expression="(i2*100)/it"/>
            <assign variable="p3" expression="(i3*100)/it"/>
            <output expression="&quot;El porcentaje del primer inversionista es: &quot; &amp; p1 &amp; &quot;%&quot;" newline="True"/>
            <output expression="&quot;El porcentaje del segundo inversionista es: &quot; &amp; p2 &amp; &quot;%&quot;" newline="True"/>
            <output expression="&quot;El porcentaje del tercer inversionista es: &quot; &amp; p3 &amp; &quot;%&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
