<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Ejercicio_1"/>
        <attribute name="authors" value="K"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-07-23 07:07:28 p.&#160;m."/>
        <attribute name="created" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wNy0yMzswNjo1NDo1OCBwLsKgbS47MjczMw=="/>
        <attribute name="edited" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wNy0yMzswNzowNzoyOCBwLsKgbS47MjsyODM4"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="num1, num2, suma, resta, multiplicacion, division" type="Real" array="False" size=""/>
            <output expression="&quot;Ingrese dos numeros: &quot;" newline="True"/>
            <input variable="num1"/>
            <input variable="num2"/>
            <assign variable="suma" expression="num1 + num2"/>
            <output expression="&quot;La suma de los numeros es: &quot; &amp; suma" newline="True"/>
            <assign variable="resta" expression="num1 - num2"/>
            <output expression="&quot;La resta de los numeros es: &quot; &amp; resta" newline="True"/>
            <assign variable="multiplicacion" expression="num1 * num2"/>
            <output expression="&quot;La multiplicacion de los numeros es: &quot; &amp; multiplicacion" newline="True"/>
            <assign variable="division" expression="num1 / num2"/>
            <output expression="&quot;La division de los numeros es: &quot; &amp; division" newline="True"/>
        </body>
    </function>
</flowgorithm>
