<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Problema_9_total_a_pagar_camisas"/>
        <attribute name="authors" value="K"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-06 11:16:56 p.&#160;m."/>
        <attribute name="created" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wOC0wNjsxMDozNTowMCBwLsKgbS47MjcxNg=="/>
        <attribute name="edited" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wOC0wNjsxMToxNjo1NiBwLsKgbS47NTsyODM5"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="precioCamisa, nCamisas, p1, p20, pT, p10, pT2" type="Real" array="False" size=""/>
            <output expression="&quot;Ingrese el n&#250;mero de camisas que compr&#243;:&quot;" newline="True"/>
            <input variable="nCamisas"/>
            <output expression="&quot;Ingrese el precio de la camisa:&quot;" newline="True"/>
            <input variable="precioCamisa"/>
            <if expression="nCamisas &gt;= 3">
                <then>
                    <assign variable="p1" expression="nCamisas*precioCamisa"/>
                    <assign variable="p20" expression="p1*20/100"/>
                    <assign variable="pT" expression="p1-p20"/>
                    <output expression="&quot;El precio total de las camisas con descuento del 20% es de: &quot; &amp; pT &amp; &quot; d&#243;lares&quot;" newline="True"/>
                </then>
                <else>
                    <assign variable="p1" expression="nCamisas*precioCamisa"/>
                    <assign variable="p10" expression="p1*10/100"/>
                    <assign variable="pT2" expression="p1-p10"/>
                    <output expression="&quot;El precio total de las camisas con descuento del 10% es de: &quot; &amp; pT2 &amp; &quot; d&#243;lares&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
