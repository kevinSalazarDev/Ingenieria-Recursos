<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Problema_19_tresNumerosSumaPrimeroYSegundo"/>
        <attribute name="authors" value="K"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-08 05:28:48 p.&#160;m."/>
        <attribute name="created" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wOC0wODswNTowMDoxMCBwLsKgbS47MjcxNQ=="/>
        <attribute name="edited" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wOC0wODswNToyODo0OCBwLsKgbS47NDsyODQ3"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="n1, n2, n3" type="Real" array="False" size=""/>
            <output expression="&quot;Ingrese tres n&#250;meros:&quot;" newline="True"/>
            <input variable="n1"/>
            <input variable="n2"/>
            <input variable="n3"/>
            <if expression="n3=n1*n2">
                <then>
                    <output expression="&quot;La multiplicaci&#243;n de &quot; &amp;n1 &amp; &quot; por &quot; &amp; n2 &amp; &quot; es &quot; &amp; n3" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;La multiplicaci&#243;n de &quot; &amp;n1 &amp; &quot; por &quot; &amp; n2 &amp; &quot; no es &quot; &amp; n3" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
