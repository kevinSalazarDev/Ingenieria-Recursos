<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Problema_11_total_llantas"/>
        <attribute name="authors" value="K"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-07 06:19:30 p.&#160;m."/>
        <attribute name="created" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wOC0wNzswNjowODoyOSBwLsKgbS47MjczMw=="/>
        <attribute name="edited" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wOC0wNzswNjoxOTozMCBwLsKgbS47NTsyODM5"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="llantas, total" type="Integer" array="False" size=""/>
            <output expression="&quot;Ingrese el n&#250;mero de llantas que compr&#243;:&quot;" newline="True"/>
            <input variable="llantas"/>
            <if expression="llantas &gt;= 5">
                <then>
                    <assign variable="total" expression="llantas*700"/>
                </then>
                <else>
                    <assign variable="total" expression="llantas*800"/>
                </else>
            </if>
            <output expression="&quot;El precio total es: &quot; &amp; total &amp; &quot; d&#243;lares&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
