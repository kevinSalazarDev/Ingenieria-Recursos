<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Problema_8_nombre_edad_sexo_imprima_nombre"/>
        <attribute name="authors" value="K"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-06 10:32:14 p.&#160;m."/>
        <attribute name="created" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wOC0wNjsxMDoyNjowMiBwLsKgbS47MjcxOA=="/>
        <attribute name="edited" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wOC0wNjsxMDozMjoxNCBwLsKgbS47MjsyODI3"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="nombre, sexo" type="String" array="False" size=""/>
            <declare name="edad" type="Integer" array="False" size=""/>
            <output expression="&quot;Ingrese su nombre:&quot;" newline="True"/>
            <input variable="nombre"/>
            <output expression="&quot;Ingrese su edad:&quot;" newline="True"/>
            <input variable="edad"/>
            <output expression="&quot;Ingrese su sexo:&quot;" newline="True"/>
            <input variable="sexo"/>
            <if expression="sexo = &quot;masculino&quot; and edad &gt;= 18">
                <then>
                    <output expression="&quot;El nombre de la persona es: &quot; &amp; nombre" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;No cumple con las condiciones&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
