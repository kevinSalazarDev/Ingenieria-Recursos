<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Problema_7_Signo_Aries"/>
        <attribute name="authors" value="K"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-06 10:23:58 p.&#160;m."/>
        <attribute name="created" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wOC0wNjsxMDoxNToyMSBwLsKgbS47MjcxNw=="/>
        <attribute name="edited" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wOC0wNjsxMDoyMzo1OCBwLsKgbS47MjsyODM1"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="nombre, signo" type="String" array="False" size=""/>
            <output expression="&quot;Ingrese su nombre:&quot;" newline="True"/>
            <input variable="nombre"/>
            <output expression="&quot;Ingrese su signo:&quot;" newline="True"/>
            <input variable="signo"/>
            <if expression="signo = &quot;aries&quot;">
                <then>
                    <output expression="nombre &amp; &quot; es aries&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;La persona no es aries&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
