<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Problema_6_salario_semanal_obrero"/>
        <attribute name="authors" value="K"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-05 10:27:46 p.&#160;m."/>
        <attribute name="created" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wOC0wMzswOToyMjo0OCBwLsKgbS47MjcyOQ=="/>
        <attribute name="edited" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wOC0wNTsxMDoyNzo0NiBwLsKgbS47NDsyODM3"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="horas, horasX16, horasX20, HorasX20HorasX16" type="Integer" array="False" size=""/>
            <output expression="&quot;Ingrese las horas de trabajo semanal:&quot;" newline="True"/>
            <input variable="horas"/>
            <if expression="horas &lt;= 40">
                <then>
                    <assign variable="horasX16" expression="horas*16"/>
                    <output expression="&quot;Su salario semanal es: &quot; &amp; horasX16 &amp; &quot; dolares &quot;" newline="True"/>
                </then>
                <else>
                    <assign variable="horasX20" expression="(horas-40)*20"/>
                    <assign variable="HorasX20HorasX16" expression="horasX20+(40*16)"/>
                    <output expression="&quot;Su salario semanal es: &quot; &amp; HorasX20HorasX16 &amp; &quot; dolares &quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
