<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Problema_13_Ecuaciones_segundo_grado"/>
        <attribute name="authors" value="K"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-07 07:04:02 p.&#160;m."/>
        <attribute name="created" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wOC0wNzswNjo0NjoyOCBwLsKgbS47MjczNA=="/>
        <attribute name="edited" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wOC0wNzswNzowNDowMiBwLsKgbS47NTsyODMz"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="a, b, c, d, r1, r2" type="Integer" array="False" size=""/>
            <output expression="&quot;Ingrese los valores de a,b y c:&quot;" newline="True"/>
            <input variable="a"/>
            <input variable="b"/>
            <input variable="c"/>
            <assign variable="d" expression="b*b - 4*a*c"/>
            <if expression="d&gt;0">
                <then>
                    <assign variable="r1" expression="(-b + sqrt(d))/2*a"/>
                    <assign variable="r2" expression="(-b - sqrt(d))/(2*a)"/>
                    <output expression="&quot;Las respuestas de la ecuaci&#243;n de segundo grado son: &quot; &amp; r1 &amp;&quot; y &quot; &amp; r2" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;La ecuaci&#243;n no tiene soluci&#243;n real&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
