<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Problema_22_dosNumerosParesOImpares"/>
        <attribute name="authors" value="K"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-08 06:41:10 p.&#160;m."/>
        <attribute name="created" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wOC0wODswNjoyMDo1MCBwLsKgbS47MjcyMg=="/>
        <attribute name="edited" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wOC0wODswNjo0MToxMCBwLsKgbS47ODsyODM2"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="n1, n2" type="Integer" array="False" size=""/>
            <output expression="&quot;Ingrese dos n&#250;meros:&quot;" newline="True"/>
            <input variable="n1"/>
            <input variable="n2"/>
            <if expression="n1 mod 2=0 and n2 mod 2=0">
                <then>
                    <output expression="&quot;Los n&#250;meros &quot; &amp;n1&amp; &quot; y &quot; &amp;n2&amp; &quot; son pares&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="n1 mod 2=0">
                        <then>
                            <output expression="n1&amp; &quot; es par y &quot; &amp;n2&amp; &quot; es impar&quot;" newline="True"/>
                        </then>
                        <else>
                            <if expression="n2 mod 2=0">
                                <then>
                                    <output expression="n2&amp; &quot; es par y &quot; &amp;n1&amp; &quot; es impar&quot;" newline="True"/>
                                </then>
                                <else>
                                    <output expression="&quot;Los n&#250;meros &quot; &amp;n1&amp; &quot; y &quot; &amp;n2&amp; &quot; son impares&quot;" newline="True"/>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
