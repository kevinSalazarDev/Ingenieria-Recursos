<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Problema_6_salario_semanal_obrero"/>
        <attribute name="authors" value="K"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-03 11:09:54 p.&#160;m."/>
        <attribute name="created" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wOC0wMzswOToyMjo0OCBwLsKgbS47MjcyOQ=="/>
        <attribute name="edited" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wOC0wMzsxMTowOTo1NCBwLsKgbS47NDsyODM1"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="horas, horasextra, hora, salario" type="Integer" array="False" size=""/>
            <output expression="&quot;Ingrese las horas de trabajo semanal:&quot;" newline="True"/>
            <input variable="horas"/>
            <if expression="horas &lt;= 40">
                <then>
                    <assign variable="salario" expression="horas*16"/>
                </then>
                <else>
                    <assign variable="horasextra" expression="horas-40"/>
                    <assign variable="hora" expression="horas - horasextra"/>
                    <assign variable="salario" expression="(hora*16) + (horasextra*20)"/>
                </else>
            </if>
            <output expression="&quot;El salario es: &quot; &amp; salario" newline="True"/>
        </body>
    </function>
</flowgorithm>
