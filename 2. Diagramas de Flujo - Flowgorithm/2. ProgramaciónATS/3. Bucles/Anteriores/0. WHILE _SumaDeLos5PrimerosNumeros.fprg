<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="1. SumaDeLos5PrimerosNumeros"/>
        <attribute name="authors" value="K"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-08 10:48:07 p.&#160;m."/>
        <attribute name="created" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wOC0wODswNzo1MTozMiBwLsKgbS47MjcyNw=="/>
        <attribute name="edited" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wOC0wODsxMDo0ODowNyBwLsKgbS47MzI7Mjg4OQ=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="i, suma" type="Integer" array="False" size=""/>
            <assign variable="i" expression="1"/>
            <assign variable="suma" expression="0"/>
            <while expression="i&lt;=5">
                <assign variable="suma" expression="suma+i"/>
                <assign variable="i" expression="i+1"/>
            </while>
            <output expression="&quot;La suma es: &quot; &amp; suma" newline="True"/>
        </body>
    </function>
</flowgorithm>
