<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="5. FOR_Sumar 1-2+3-4..."/>
        <attribute name="authors" value="K"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-09 07:45:21 p.&#160;m."/>
        <attribute name="created" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wOC0wOTswNzoyOTozMiBwLsKgbS47MjczMw=="/>
        <attribute name="edited" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wOC0wOTswNzo0NToyMSBwLsKgbS47NzsyODQz"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numero, i, suma, n, suma1, sumaTotal" type="Integer" array="False" size=""/>
            <assign variable="suma" expression="0"/>
            <assign variable="suma1" expression="0"/>
            <output expression="&quot;Digite un n&#250;mero:&quot;" newline="True"/>
            <input variable="numero"/>
            <for variable="i" start="1" end="numero" direction="inc" step="1">
                <if expression="i mod 2=0">
                    <then>
                        <assign variable="suma1" expression="suma1+(-i)"/>
                    </then>
                    <else>
                        <assign variable="suma" expression="suma+i"/>
                    </else>
                </if>
            </for>
            <assign variable="sumaTotal" expression="suma+suma1"/>
            <output expression="&quot;La suma es &quot; &amp; sumaTotal" newline="True"/>
        </body>
    </function>
</flowgorithm>
