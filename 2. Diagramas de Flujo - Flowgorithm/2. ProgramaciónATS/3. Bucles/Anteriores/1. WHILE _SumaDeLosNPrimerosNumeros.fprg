<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="1. SumaDeLos5PrimerosNumeros"/>
        <attribute name="authors" value="K"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-09 03:41:30 p.&#160;m."/>
        <attribute name="created" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wOC0wODswNzo1MTozMiBwLsKgbS47MjcyNw=="/>
        <attribute name="edited" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wOC0wOTswMzo0MTozMCBwLsKgbS47MzU7Mjg4NA=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numero, i, suma" type="Integer" array="False" size=""/>
            <assign variable="suma" expression="0"/>
            <output expression="&quot;Digite el n&#250;mero de los elementos:&quot;" newline="True"/>
            <input variable="numero"/>
            <for variable="i" start="1" end="numero" direction="inc" step="1">
                <assign variable="suma" expression="suma+i"/>
            </for>
            <output expression="&quot;La suma de &quot; &amp;numero&amp; &quot; elementos es: &quot; &amp; suma" newline="True"/>
        </body>
    </function>
</flowgorithm>
