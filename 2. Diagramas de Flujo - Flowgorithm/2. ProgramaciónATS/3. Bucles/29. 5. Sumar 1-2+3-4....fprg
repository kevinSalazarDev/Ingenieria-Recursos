<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="29. 5. Sumar 1-2+3-4..."/>
        <attribute name="authors" value="K"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-11-09 02:37:01 p.&#160;m."/>
        <attribute name="created" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0xMS0wOTswMjoxNzowNyBwLsKgbS47MjcyMQ=="/>
        <attribute name="edited" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0xMS0wOTswMjozNzowMSBwLsKgbS47NjsyODMw"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numero, suma, n, suma1, sumaTotal, contador" type="Integer" array="False" size=""/>
            <assign variable="numero" expression="0"/>
            <assign variable="suma" expression="0"/>
            <assign variable="suma1" expression="0"/>
            <output expression="&quot;Ingrese el n&#250;mero de elementos: &quot;" newline="True"/>
            <input variable="numero"/>
            <for variable="contador" start="1" end="numero" direction="inc" step="1">
                <if expression="contador mod 2 = 0">
                    <then>
                        <assign variable="n" expression="contador * (-1)"/>
                        <assign variable="suma1" expression="suma1 + n"/>
                    </then>
                    <else>
                        <assign variable="suma" expression="suma + contador"/>
                    </else>
                </if>
                <assign variable="sumaTotal" expression="suma + suma1"/>
            </for>
            <output expression="&quot;La suma es: &quot;&amp;sumaTotal" newline="True"/>
        </body>
    </function>
</flowgorithm>
