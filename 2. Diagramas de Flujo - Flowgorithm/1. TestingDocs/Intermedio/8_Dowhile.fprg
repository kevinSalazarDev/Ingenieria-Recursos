    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="eleccionDelUsuario" type="Integer" array="False" size=""/>
            <do expression="eleccionDelUsuario !=3">
                <output expression="&quot;Men&#250; del programa:&quot;" newline="True"/>
                <output expression="&quot;1. Tarea 1&quot;" newline="True"/>
                <output expression="&quot;2. Tarea 2&quot;" newline="True"/>
                <output expression="&quot;3. Salir&quot;" newline="True"/>
                <output expression="&quot;Por favor, seleccione una opci&#243;n del men&#250;:&quot;" newline="True"/>
                <input variable="eleccionDelUsuario"/>
                <if expression="eleccionDelUsuario == 1">
                    <then>
                        <output expression="&quot;Realizando la tarea 1........&quot;" newline="True"/>
                    </then>
                    <else/>
                </if>
                <if expression="eleccionDelUsuario == 2">
                    <then>
                        <output expression="&quot;Realizando la tarea 2........&quot;" newline="True"/>
                    </then>
                    <else/>
                </if>
            </do>
        </body>
    </function>
