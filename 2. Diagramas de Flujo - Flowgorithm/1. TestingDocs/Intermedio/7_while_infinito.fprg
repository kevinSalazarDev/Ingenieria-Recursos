<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="7_while_infinito"/>
        <attribute name="authors" value="K"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-07-30 08:28:44 p.&#160;m."/>
        <attribute name="created" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wNy0zMDswODoyNTo1NyBwLsKgbS47MjczMA=="/>
        <attribute name="edited" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wNy0zMDswODoyODo0NCBwLsKgbS47MTsyODM3"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="bucleNumero" type="Integer" array="False" size=""/>
            <assign variable="bucleNumero" expression="0"/>
            <while expression="True">
                <assign variable="bucleNumero" expression="bucleNumero+1"/>
                <output expression="&quot;Este bucle se ejecutar&#225; por siempre...&quot; &amp; bucleNumero" newline="True"/>
            </while>
        </body>
    </function>
</flowgorithm>
