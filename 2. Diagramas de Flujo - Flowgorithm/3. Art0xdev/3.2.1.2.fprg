    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="paisDeNacimiento" type="String" array="False" size=""/>
            <input variable="paisDeNacimiento"/>
            <if expression="paisDeNacimiento == &quot;Ecuador&quot; || paisDeNacimiento == &quot;Colombia&quot;">
                <then>
                    <output expression="&quot;Enhorabuena, cumple con las condiciones para entrar al ejercito ecuatoriano&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Lo sentimos, no cumple con las condiciones para entrar al ejercito ecuatoriano&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
