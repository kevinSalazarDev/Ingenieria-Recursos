    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="fahrenheit, celsius" type="Real" array="False" size=""/>
            <output expression="&quot;Ingrese los grados Fahrenheit:&quot;" newline="True"/>
            <input variable="fahrenheit"/>
            <assign variable="celsius" expression="5 * (fahrenheit - 32)/9"/>
            <output expression="celsius &amp; &quot; grados Celsius&quot;" newline="True"/>
        </body>
    </function>
