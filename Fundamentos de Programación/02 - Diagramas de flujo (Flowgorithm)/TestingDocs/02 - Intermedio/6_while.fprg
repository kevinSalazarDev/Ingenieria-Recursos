<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="6_while"/>
        <attribute name="authors" value="K"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-07-30 08:24:14 p.&#160;m."/>
        <attribute name="created" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wNy0zMDswODoxNzo1NiBwLsKgbS47MjczMA=="/>
        <attribute name="edited" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wNy0zMDswODoyNDoxNCBwLsKgbS47MTsyODMw"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="name" type="String" array="False" size=""/>
            <assign variable="name" expression="&quot;&quot;"/>
            <while expression="name != &quot;SALIR&quot;">
                <output expression="&quot;Ingrese el nombre de su amigo:&quot;" newline="True"/>
                <input variable="name"/>
                <if expression="name !=&quot;SALIR&quot;">
                    <then>
                        <output expression="&quot;El nombre de su amigo es:&quot; &amp; name" newline="True"/>
                    </then>
                    <else/>
                </if>
            </while>
        </body>
    </function>
</flowgorithm>
