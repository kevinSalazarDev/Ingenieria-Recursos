    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="distancia, galones, mpg" type="Real" array="False" size=""/>
            <output expression="&quot;Ingrese la distancia a recorrer: &quot;" newline="True"/>
