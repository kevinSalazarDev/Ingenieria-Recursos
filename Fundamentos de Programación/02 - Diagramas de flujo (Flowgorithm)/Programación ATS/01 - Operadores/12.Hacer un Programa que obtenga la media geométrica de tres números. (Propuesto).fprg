    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="n1, n2, n3, mediaGeometrica" type="Real" array="False" size=""/>
            <output expression="&quot;Ingrese el primer n&#250;mero:&quot;" newline="True"/>
            <input variable="n1"/>
            <output expression="&quot;Ingrese el segundo n&#250;mero:&quot;" newline="True"/>
            <input variable="n2"/>
            <output expression="&quot;Ingrese el tercer n&#250;mero:&quot;" newline="True"/>
            <input variable="n3"/>
            <assign variable="mediaGeometrica" expression="(n1*n2*n3)^(1/3)"/>
            <output expression="&quot;La media geom&#233;trica de los tres n&#250;meros es: &quot; &amp; mediaGeometrica" newline="True"/>
        </body>
    </function>
</flowgorithm>
