<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Ejercicio_14"/>
        <attribute name="authors" value="K"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-07-28 07:54:16 p.&#160;m."/>
        <attribute name="created" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wNy0yODswNzo0MjozOSBwLsKgbS47MjczNQ=="/>
        <attribute name="edited" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wNy0yODswNzo1NDoxNiBwLsKgbS47MjsyODQy"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="arista, volumen, area" type="Real" array="False" size=""/>
            <output expression="&quot;Ingrese la arista del cubo:&quot;" newline="True"/>
            <input variable="arista"/>
            <assign variable="volumen" expression="arista*arista*arista"/>
            <assign variable="area" expression="6*(arista*arista)"/>
            <output expression="&quot;El volumen del cubo es: &quot; &amp; volumen &amp; &quot; cm^3&quot;" newline="True"/>
            <output expression="&quot;El &#225;rea del cubo es: &quot; &amp; area &amp; &quot; cm^2&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
