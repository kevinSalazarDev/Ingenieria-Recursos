<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Problema_5_dado_dos_numeros_imprimir_solo_los_positivos"/>
        <attribute name="authors" value="K"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-05 10:05:46 p.&#160;m."/>
        <attribute name="created" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wOC0wMzswOToxMzoxNyBwLsKgbS47MjcyNQ=="/>
        <attribute name="edited" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wOC0wNTsxMDowNTo0NiBwLsKgbS47NjsyODM1"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="n1, n2" type="Integer" array="False" size=""/>
            <output expression="&quot;Ingrese dos n&#250;mero:&quot;" newline="True"/>
            <input variable="n1"/>
            <input variable="n2"/>
            <if expression="n1 &gt; 0 and n2 &gt; 0">
                <then>
                    <output expression="&quot;Los n&#250;meros &quot; &amp; n1 &amp; &quot; y &quot; &amp; n2 &amp; &quot; son positivos&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="n1&lt;0 and n2&lt;0">
                        <then>
                            <output expression="&quot;Los n&#250;meros &quot; &amp; n1 &amp; &quot; y &quot; &amp; n2 &amp; &quot; no son positivos&quot;" newline="True"/>
                        </then>
                        <else>
                            <if expression="n1&gt;0">
                                <then>
                                    <output expression="&quot;Solo el n&#250;mero &quot; &amp; n1 &amp; &quot; es positivo&quot;" newline="True"/>
                                </then>
                                <else>
                                    <if expression="n2&gt;0">
                                        <then>
                                            <output expression="&quot;Solo el n&#250;mero &quot; &amp; n2 &amp; &quot; es positivo&quot;" newline="True"/>
                                        </then>
                                        <else>
                                            <output expression="&quot;Ninguno de los n&#250;meros es positivo&quot;" newline="True"/>
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
