<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Problema_10_descuento_15_y_20_azar"/>
        <attribute name="authors" value="K"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-07 12:11:25 a.&#160;m."/>
        <attribute name="created" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wOC0wNjsxMTo1MDozNiBwLsKgbS47MjcyMw=="/>
        <attribute name="edited" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wOC0wNzsxMjoxMToyNSBhLsKgbS47MzsyODE1"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="total, numeroAzar, descuento" type="Real" array="False" size=""/>
            <output expression="&quot;Ingrese el precio total de la compra:&quot;" newline="True"/>
            <input variable="total"/>
            <assign variable="numeroAzar" expression="random(100)+1"/>
            <if expression="numeroAzar &gt;= 74">
                <then>
                    <assign variable="descuento" expression="total*20/100"/>
                </then>
                <else>
                    <assign variable="descuento" expression="total*15/100"/>
                </else>
            </if>
            <output expression="&quot;El descuento es: &quot; &amp; descuento" newline="True"/>
        </body>
    </function>
</flowgorithm>
