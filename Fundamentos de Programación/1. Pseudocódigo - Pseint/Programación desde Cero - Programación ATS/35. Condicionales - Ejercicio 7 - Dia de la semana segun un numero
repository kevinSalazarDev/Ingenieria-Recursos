//Elaborar un programa que me muestre los días de las 
//semanas cuando ingrese los siete primeros números.
//(Pseudocódigo)

Proceso ejercicio7
	Definir num Como Entero;
	
	Escribir "Ingrese un número del 1 al 7: ";
	Leer num;
	
	si num = 1 Entonces
		Escribir "Lunes";
	sino 
		si num = 2 Entonces
			Escribir "Martes";
		sino
			si num = 3 Entonces
				Escribir "Miércoles";
			sino 
				si num = 4 Entonces
					Escribir "Jueves";
				SiNo
					si num = 5 Entonces
						Escribir "Viernes";
					sino 
						si num = 6 Entonces
							Escribir "Sábado";
						SiNo
							si num = 7 Entonces
								Escribir "Domingo";
							SiNo
								Escribir "Valor incorrecto";
						
							FinSi
						FinSi
					FinSi
				FinSi

			FinSi
		FinSi
	FinSi
	
	
	
FinProceso
