//Ejercicio 1: Calcular la suma de los "N" primeros números.

Proceso ejericicio1
	Definir N,suma,i Como Entero;
	
	Escribir "Ingrese la cantidad de números a sumarse: ";
	Leer N;
	
	suma <- 0;
	
	Para i <- 1 hasta  N Con Paso 1 Hacer
		suma <- suma + i;
		
	FinPara
	
	Escribir "La suma es: ",suma;
	
	
FinProceso
