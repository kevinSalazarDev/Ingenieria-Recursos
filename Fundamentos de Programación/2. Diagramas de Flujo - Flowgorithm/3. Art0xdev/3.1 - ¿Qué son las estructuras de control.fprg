    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="edadPersona" type="Integer" array="False" size=""/>
            <input variable="edadPersona"/>
            <declare name="edadMinimaEjercito" type="Integer" array="False" size=""/>
            <assign variable="edadMinimaEjercito" expression="18"/>
            <if expression="edadPersona &gt;= 18">
                <then>
                    <output expression="&quot;ENHORABUENA, puede ingresar al ejercito&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Lo siento,debe esperar mas a&#241;os&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
