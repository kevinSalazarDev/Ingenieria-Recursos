<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Problema_13_Ecuaciones_segundo_grado"/>
        <attribute name="authors" value="K"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-07 07:11:45 p.&#160;m."/>
        <attribute name="created" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wOC0wNzswNjo0NjoyOCBwLsKgbS47MjczNA=="/>
        <attribute name="edited" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wOC0wNzswNzoxMTo0NSBwLsKgbS47ODsyODQx"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="a, b, c, d, r1, r2" type="Real" array="False" size=""/>
            <output expression="&quot;Ingrese los valores de a,b y c:&quot;" newline="True"/>
            <input variable="a"/>
            <input variable="b"/>
            <input variable="c"/>
            <assign variable="d" expression="b*b - 4*a*c"/>
            <if expression="d&gt;0">
                <then>
                    <assign variable="r1" expression="(-b + sqrt(d))/(2*a)"/>
                    <assign variable="r2" expression="(-b - sqrt(d))/(2*a)"/>
                    <output expression="&quot;Las ecuaci&#243;n tiene dos soluciones reales: &quot; &amp; r1 &amp;&quot; y &quot; &amp; r2" newline="True"/>
                </then>
                <else>
                    <if expression="d=0">
                        <then>
                            <assign variable="r1" expression="-b / (2*a)"/>
                            <output expression="&quot;La ecuaci&#243;n tiene una soluci&#243;n real doble: &quot; &amp; r1" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;La ecuaci&#243;n no tiene soluci&#243;n real&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
