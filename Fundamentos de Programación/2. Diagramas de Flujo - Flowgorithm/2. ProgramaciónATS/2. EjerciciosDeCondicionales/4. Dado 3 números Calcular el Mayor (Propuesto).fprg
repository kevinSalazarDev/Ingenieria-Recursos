<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Problema_3_dado_tres_numeros_calcular_el_mayor"/>
        <attribute name="authors" value="K"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-03 08:48:02 p.&#160;m."/>
        <attribute name="created" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wOC0wMzswODoyODozOSBwLsKgbS47MjczNA=="/>
        <attribute name="edited" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wOC0wMzswODo0ODowMiBwLsKgbS47NDsyODM3"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="n1, n2, n3" type="Integer" array="False" size=""/>
            <output expression="&quot;Ingrese tres n&#250;meros:&quot;" newline="True"/>
            <input variable="n1"/>
            <input variable="n2"/>
            <input variable="n3"/>
            <if expression="n1 &gt; n2">
                <then>
                    <if expression="n1 &gt; n3">
                        <then>
                            <output expression="&quot;El n&#250;mero &quot; &amp; n1 &amp; &quot; es mayor que &quot; &amp; n2 &amp; &quot; y &quot; &amp; n3" newline="True"/>
                        </then>
                        <else/>
                    </if>
                </then>
                <else>
                    <if expression="n2 &gt; n1">
                        <then>
                            <if expression="n2 &gt; n3">
                                <then>
                                    <output expression="&quot;El n&#250;mero &quot; &amp; n2 &amp; &quot; es mayor que &quot; &amp; n1 &amp; &quot; y &quot; &amp; n3" newline="True"/>
                                </then>
                                <else>
                                    <if expression="n3&gt;n1">
                                        <then>
                                            <if expression="n3&gt;n2">
                                                <then>
                                                    <output expression="&quot;El n&#250;mero &quot; &amp; n3 &amp; &quot; es mayor que &quot; &amp; n1 &amp; &quot; y &quot; &amp; n2" newline="True"/>
                                                </then>
                                                <else/>
                                            </if>
                                        </then>
                                        <else/>
                                    </if>
                                </else>
                            </if>
                        </then>
                        <else/>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
