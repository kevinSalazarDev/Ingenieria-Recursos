    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="c1, c2, hip" type="Real" array="False" size=""/>
            <output expression="&quot;Ingrese el cateto opuesto:&quot;" newline="True"/>
            <input variable="c1"/>
            <output expression="&quot;Ingrese el cateto adyacente:&quot;" newline="True"/>
            <input variable="c2"/>
            <assign variable="hip" expression="sqrt ((c1)^2 + (c2)^2)"/>
            <output expression="&quot;La hipotenusa del triangulo rectangulo es: &quot; &amp; hip" newline="True"/>
        </body>
    </function>
</flowgorithm>
