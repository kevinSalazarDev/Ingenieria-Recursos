    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="n1, n2, n3, media" type="Real" array="False" size=""/>
            <output expression="&quot;Ingrese el primer numero:&quot;" newline="True"/>
            <input variable="n1"/>
            <output expression="&quot;Ingrese el segundo numero:&quot;" newline="True"/>
            <input variable="n2"/>
            <output expression="&quot;Ingrese el tercer numero&quot;" newline="True"/>
            <input variable="n3"/>
            <assign variable="media" expression="(n1 + n2 + n3) / 3"/>
            <output expression="&quot;La media aritmetica de los numeros es: &quot; &amp; media" newline="True"/>
        </body>
    </function>
</flowgorithm>
