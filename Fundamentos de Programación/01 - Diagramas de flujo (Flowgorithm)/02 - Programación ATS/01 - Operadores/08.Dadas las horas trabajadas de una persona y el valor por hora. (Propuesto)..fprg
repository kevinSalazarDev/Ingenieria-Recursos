    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="horas, valor, salario" type="Real" array="False" size=""/>
            <output expression="&quot;Ingrese el n&#250;mero de horas trabajadas:&quot;" newline="True"/>
            <input variable="horas"/>
            <output expression="&quot;Ingrese el valor por hora: &quot;" newline="True"/>
            <input variable="valor"/>
            <assign variable="salario" expression="horas * valor"/>
            <output expression="&quot;Su salario es: &quot; &amp; salario" newline="True"/>
        </body>
    </function>
