<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Ejercicio_13"/>
        <attribute name="authors" value="K"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-07-28 07:42:17 p.&#160;m."/>
        <attribute name="created" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wNy0yODswNzoyNzo0NiBwLsKgbS47MjczNg=="/>
        <attribute name="edited" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wNy0yODswNzo0MjoxNyBwLsKgbS47MzsyODQx"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numeroDeHombres, numeroDeMujeres, totalDeAlumnos, porcentajeDeHombres, porcentajeDeMujeres" type="Real" array="False" size=""/>
            <output expression="&quot;Ingrese el n&#250;mero de hombres:&quot;" newline="True"/>
            <input variable="numeroDeHombres"/>
            <output expression="&quot;Ingrese el n&#250;mero de mujeres:&quot;" newline="True"/>
            <input variable="numeroDeMujeres"/>
            <assign variable="totalDeAlumnos" expression="numeroDeHombres+numeroDeMujeres"/>
            <assign variable="porcentajeDeHombres" expression="(numeroDeHombres*100)/totalDeAlumnos"/>
            <assign variable="porcentajeDeMujeres" expression="(numeroDeMujeres*100)/totalDeAlumnos"/>
            <output expression="&quot;El porcentaje de hombres es: &quot; &amp; porcentajeDeHombres &amp; &quot;%&quot; &amp;&quot;.&quot;&amp; &quot; El porcentaje de mujeres es: &quot; &amp; porcentajeDeMujeres &amp; &quot;%&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
