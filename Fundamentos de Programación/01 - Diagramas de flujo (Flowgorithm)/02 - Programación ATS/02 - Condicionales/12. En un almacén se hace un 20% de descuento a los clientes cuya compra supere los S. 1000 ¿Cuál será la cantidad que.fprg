<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Problema_12_descuento_20"/>
        <attribute name="authors" value="K"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-07 06:33:23 p.&#160;m."/>
        <attribute name="created" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wOC0wNzswNjoyMTowNCBwLsKgbS47MjcyMQ=="/>
        <attribute name="edited" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wOC0wNzswNjozMzoyMyBwLsKgbS47NDsyODM2"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="compra, descuento, total" type="Real" array="False" size=""/>
            <output expression="&quot;Ingrese el valor de su compra:&quot;" newline="True"/>
            <input variable="compra"/>
            <if expression="compra &gt; 1000">
                <then>
                    <assign variable="descuento" expression="compra*20/100"/>
                    <assign variable="total" expression="compra-descuento"/>
                    <output expression="&quot;El valor de su compra con descuento del 20% es de: $&quot; &amp; total" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Para obtener el descuento del 20% debe comprar una cantidad superior a $1000&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
