<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Problema_3_par_impar_cero"/>
        <attribute name="authors" value="K"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-04 12:44:10 a.&#160;m."/>
        <attribute name="created" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wOC0wMzswODoyMjo0NyBwLsKgbS47MjcyNw=="/>
        <attribute name="edited" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wOC0wNDsxMjo0NDoxMCBhLsKgbS47MzsyODEy"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="n" type="Integer" array="False" size=""/>
            <output expression="&quot;Ingrese un n&#250;mero:&quot;" newline="True"/>
            <input variable="n"/>
            <if expression="n = 0">
                <then>
                    <output expression="&quot;El n&#250;mero es cero&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="(n/2)*2 = n">
                        <then>
                            <output expression="&quot;El n&#250;mero &quot; &amp; n &amp; &quot; es par&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;El n&#250;mero &quot; &amp; n &amp; &quot; es impar&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
