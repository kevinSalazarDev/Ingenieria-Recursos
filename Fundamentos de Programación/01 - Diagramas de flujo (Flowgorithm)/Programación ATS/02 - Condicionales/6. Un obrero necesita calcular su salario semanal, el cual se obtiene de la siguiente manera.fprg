<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Problema_6_salario_semanal_obrero"/>
        <attribute name="authors" value="K"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-03 10:55:05 p.&#160;m."/>
        <attribute name="created" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wOC0wMzswOToyMjo0OCBwLsKgbS47MjcyOQ=="/>
        <attribute name="edited" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wOC0wMzsxMDo1NTowNSBwLsKgbS47MjsyODI5"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="horas, horasX16, horasExtras20, horasMashorasExtrasX20, horasX16MashorasExtrasX20" type="Integer" array="False" size=""/>
            <output expression="&quot;Ingrese las horas de trabajo semanal:&quot;" newline="True"/>
            <input variable="horas"/>
            <if expression="horas &lt;= 40">
                <then>
                    <assign variable="horasX16" expression="horas*16"/>
                    <output expression="&quot;Su salario semanal es: &quot; &amp; horasX16 &amp; &quot; dolares &quot;" newline="True"/>
                </then>
                <else>
                    <if expression="horas &gt; 40">
                        <then>
                            <assign variable="horasExtras20" expression="(horas mod 40)*20"/>
                            <assign variable="horasX16MashorasExtrasX20" expression="(40*16)+horasExtras20"/>
                            <output expression="&quot;Su salario semanal es: &quot; &amp; horasX16MashorasExtrasX20 &amp; &quot; dolares &quot;" newline="True"/>
                        </then>
                        <else/>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
