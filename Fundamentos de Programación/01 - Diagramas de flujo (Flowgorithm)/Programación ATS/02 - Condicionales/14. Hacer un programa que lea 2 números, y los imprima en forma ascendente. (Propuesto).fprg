<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Problema_14_2numeros_ascendentes"/>
        <attribute name="authors" value="K"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-07 09:19:09 p.&#160;m."/>
        <attribute name="created" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wOC0wNzswOTowNzoxNSBwLsKgbS47MjczMA=="/>
        <attribute name="edited" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wOC0wNzswOToxOTowOSBwLsKgbS47NDsyODQ3"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="n1, n2" type="Real" array="False" size=""/>
            <output expression="&quot;Ingrese dos n&#250;meros:&quot;" newline="True"/>
            <input variable="n1"/>
            <input variable="n2"/>
            <if expression="n1&lt;n2">
                <then>
                    <output expression="n1 &amp; &quot;,&quot; &amp;n2" newline="True"/>
                </then>
                <else>
                    <output expression="n2&amp; &quot;,&quot; &amp;n1" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
