<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="youtube 1"/>
        <attribute name="authors" value="K"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-06-21 10:13:16 a.&#160;m."/>
        <attribute name="created" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wNi0yMDsxMDoxMjoxNSBwLsKgbS47MjcxMQ=="/>
        <attribute name="edited" value="SztERVNLVE9QLTRPUjYzUUI7MjAyNi0wNi0yMTsxMDoxMzoxNiBhLsKgbS47MzsyODA5"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="nacimientoUsuario" type="Integer" array="False" size=""/>
            <input variable="nacimientoUsuario"/>
            <declare name="a&#241;oActual" type="Integer" array="False" size=""/>
            <assign variable="a&#241;oActual" expression="2020"/>
            <declare name="edadCarnetConducir" type="Integer" array="False" size=""/>
            <assign variable="edadCarnetConducir" expression="18"/>
            <declare name="edadUsuario" type="Integer" array="False" size=""/>
            <assign variable="edadUsuario" expression="a&#241;oActual - nacimientoUsuario"/>
            <if expression="edadUsuario &gt;= edadCarnetConducir">
                <then>
                    <output expression="&quot;Usuario SI PUEDE SACARSE EL CARNET DE CONDUCIR&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Usuario NO PUEDE SACARSE EL CARNET DE CONDUCIR&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
